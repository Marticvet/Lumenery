# Set the public origin when the domain is ready (no trailing path).
SITE_URL=http://localhost:3000

# Same SMTP delivery model as Built Further; use Lumynery's own mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Lumynery
MAIL_FROM_ADDRESS=
MAIL_TO_ADDRESS=

# A separate Lumynery EU PostHog project. Blank disables tracking and its banner.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Sanity CMS. Public identifiers, safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only Viewer token for private datasets. Never prefix with NEXT_PUBLIC or commit its value.
SANITY_API_READ_TOKEN=
