    "studio:deploy": "pnpm --dir studio run deploy",
    "studio:seed": "pnpm --dir studio run seed"
  },
  "dependencies": {
    "next": "16.3.0",
    "next-sanity": "^13.3.4",
    "nodemailer": "^9.1.1",
    "posthog-js": "^1.433.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.4"
