{
  "name": "lumenery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/functionality.test.cjs",
    "test:routes": "node --test tests/routes.test.cjs",
    "studio:login": "pnpm --dir studio exec sanity login",
